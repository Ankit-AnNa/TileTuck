# Frontend domains allowed to call the API (comma-separated)
ALLOWED_ORIGINS=https://your-frontend-url.com,https://your-other-domain.com

# SMTP config for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=TileTuck <your-sender@example.com>
PUBLIC_APP_URL=https://your-frontend-url.com

# Optional: use SSL for SMTP
SMTP_USE_SSL=false
